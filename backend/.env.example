# LLM & AI Keys (Backend only - never commit actual values)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Services (Backend only)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Google Maps Platform (Frontend Maps JS & Places)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# LLM Routing Configuration (gemini | groq)
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# Server Configuration
PORT=8080
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://hack-arena-xi.vercel.app,http://localhost:3000
